{
  "name": "shift-k",
  "version": "0.1.0",
  "description": "AI Director workflow orchestrator — routes AI-generated files to the right client folder automatically",
  "author": {
    "name": "Hadrien Durand-Baissas",
    "email": "hadridb@gmail.com"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n renderer,main,electron -c cyan,yellow,green \"npm run dev:renderer\" \"npm run dev:main-watch\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main-watch": "concurrently -k -n tsc,alias -c blue,magenta \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.main.json --watch\"",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "baseline-browser-mapping": "^2.10.29",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
