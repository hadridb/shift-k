{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "release"]
}
